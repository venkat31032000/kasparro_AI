# Application
APP_NAME=Kasparro AI Visibility Evaluation
DATABASE_URL=sqlite:///./kasparro.db

# LLM configuration
# Leave blank when using keyless replay mode.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200

# Local assignment identities
ANALYST_TOKEN=local-analyst-token
REVIEWER_TOKEN=local-reviewer-token